# Palavra-passe de acesso (obrigatória se expuseres via Cloudflare Tunnel)
APP_PASSWORD=muda-isto

# Opcional: chave fixa para as sessões (se vazio, é gerada e guardada em /data)
SECRET_KEY=

# spotDL (formato, qualidade, pasta e estrutura configuram-se na app, em Configurações)
SPOTDL_THREADS=2
# Estrutura de pastas: Artista/Álbum/01 - Título.mp3
SPOTDL_OUTPUT={album-artist}/{album}/{track-number} - {title}.{output-ext}

# Recomendado: credenciais próprias da Spotify API (developer.spotify.com > Dashboard > Create app)
# Sem elas o spotDL usa credenciais partilhadas, que às vezes dão "rate limit".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Argumentos extra para o spotDL, ex.: --cookie-file /data/cookies.txt
SPOTDL_EXTRA_ARGS=

# Ler a pasta de música ao arrancar (só processa ficheiros novos/alterados)
SCAN_ON_START=1
# Atualizar o yt-dlp a cada arranque do container
UPDATE_YTDLP=1
